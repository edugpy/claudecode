# Nombre de la radio (aparece en el boletin)
RADIO_NAME=Radio AM Villarrica

# Directorio de salida para los PDFs generados
OUTPUT_DIR=output

# -----------------------------------------------
# EMAIL — se recomienda Gmail con App Password
# -----------------------------------------------
EMAIL_SENDER=tucorreo@gmail.com
# Generar App Password en: Google Account > Seguridad > Contrasenas de aplicacion
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
# Lista separada por comas
EMAIL_RECIPIENTS=destinatario1@email.com,destinatario2@email.com

# -----------------------------------------------
# WHATSAPP — via Twilio (https://twilio.com)
# -----------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numero del sandbox de Twilio (no cambiar en pruebas)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Numeros destinatarios con codigo de pais (Paraguay: +595)
# Los destinatarios deben activar el sandbox de Twilio primero
WHATSAPP_RECIPIENTS=+595981000000,+595982000000
